local function onCharacter(char)
	task.wait(0.35)
	local hum = char:WaitForChild("Humanoid", 5)
	if not hum then return end

	installSpeedSpoof(hum)
	applySpeed()

	hum.HealthChanged:Connect(function()
		if Toggles.Godmode and Toggles.Godmode.Value then
			hum.Health = hum.MaxHealth
		end
	end)

	-- if game resets WalkSpeed, put ours back (without spam)
	hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if Toggles.WalkSpeedEnabled and Toggles.WalkSpeedEnabled.Value then
			local target = Options.WalkSpeed and Options.WalkSpeed.Value or 22
			if math.abs(hum.WalkSpeed - target) > 0.5 then
				task.defer(function()
					if Toggles.WalkSpeedEnabled.Value then
						hum.WalkSpeed = target
					end
				end)
			end
		end
	end)
end

