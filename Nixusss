	"Blitz", "Haste", "Lookman", "A-60", "A-90", "A-120", "A60", "A90", "A120",
	"The Groundskeeper", "Mandrake", "Monument", "Eyestalk", "Bramble", "Surge", "Caw", "Grampy", "The World Lotus",
	"Honcho", "Alma", "Teller", "Ransom", "Drones", "Bash", "Scribbles", "Forget-Me-Not",
	"Portrait", "Fih", "Creak", "Noise", "Stem", "Cobbler", "Meld", "Hijack",
	"The Unnamed Red Light", "Glitch",
	"RushMoving", "AmbushMoving", "SeekMoving", "FigureRig",
}

local function shouldKill(name)
	if not (Toggles.AntiAll and Toggles.AntiAll.Value) then return false end
	for _, n in ipairs(KillList) do
		if name == n then return true end
	end
	return false
end

local function neutralize(obj)
	pcall(function()
		for _, c in ipairs(obj:GetDescendants()) do
			if c:IsA("Sound") then c.Volume = 0 c:Stop() end
			if c:IsA("BasePart") then c.CanCollide = false c.Transparency = 1 end
			if c:IsA("ParticleEmitter") or c:IsA("Trail") then c.Enabled = false end
		end
		obj:Destroy()
	end)
end

local function findNearestCloset()
	local root = getRoot()
	if not root then return nil end
	local closest, dist = nil, 50
	for _, obj in ipairs(workspace:GetDescendants()) do
		local n = string.lower(obj.Name)
		if string.find(n, "closet") or string.find(n, "wardrobe") or string.find(n, "cabinet") or string.find(n, "locker") then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local d = (part.Position - root.Position).Magnitude
				if d < dist then closest = obj dist = d end
			end
		end
	end
	return closest
end

local function forceHide()
	local closet = findNearestCloset()
	if not closet then return end
	local prompt = closet:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then safeFirePrompt(prompt) end
	local part = closet:IsA("BasePart") and closet or closet:FindFirstChildWhichIsA("BasePart", true)
	local root = getRoot()
	if part and root then
		pcall(function() root.CFrame = part.CFrame * CFrame.new(0, 1.5, 0) end)
	end
end

local lastNotify = 0

local function processEntity(obj)
	if not obj or not obj.Parent then return end
	if not shouldKill(obj.Name) then return end
	table.insert(State.EntityList, obj)
	if Toggles.NotifyEntities and Toggles.NotifyEntities.Value and (tick() - lastNotify) > 1.5 then
		Library:Notify("Entity: " .. obj.Name, 2)
		lastNotify = tick()
	end
	if Toggles.AutoHide and Toggles.AutoHide.Value then
		local n = obj.Name
		if n == "Rush" or n == "Ambush" or n == "RushMoving" or n == "AmbushMoving" then
			forceHide()
		end
	end
	if Toggles.ReduceLag and Toggles.ReduceLag.Value then
		for _, s in ipairs(obj:GetDescendants()) do
			if s:IsA("Sound") then s.Volume = 0 s:Stop() end
		end
	end
	neutralize(obj)
end

task.spawn(function()
	while true do
		task.wait(0.08)
		State.EntityList = {}
		if Toggles.AntiAll and Toggles.AntiAll.Value then
			pcall(function()
				for _, obj in ipairs(workspace:GetDescendants()) do
					processEntity(obj)
				end
			end)
		end
	end
end)

workspace.DescendantAdded:Connect(function(obj)
	if Toggles.AntiAll and Toggles.AntiAll.Value then
		task.defer(function() processEntity(obj) end)
	end
end)

