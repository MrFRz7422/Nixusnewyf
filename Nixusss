-- =========================================================
-- ANTICHEAT BYPASS LAYER (inspired by the remote/metatable pattern)
-- =========================================================
local AC = {
	active = false,
	hooks = {},
}

local function safeHook(fnName, original, replacement)
	if type(hookfunction) ~= "function" then return nil end
	local ok, old = pcall(function()
		return hookfunction(original, newcclosure and newcclosure(replacement) or replacement)
	end)
	if ok then return old end
	return nil
end

-- 1) setmetatable weak-table bypass (MiscellaneousController style)
pcall(function()
	if type(getrenv) ~= "function" or type(hookfunction) ~= "function" then return end
	local env = getrenv()
	if type(env.setmetatable) ~= "function" then return end
	local old
	old = hookfunction(env.setmetatable, newcclosure and newcclosure(function(tbl, mt)
		if mt and typeof(mt) == "table" and rawget(mt, "__mode") == "kv" then
			local tr = debug.traceback()
			if tr and (tr:find("MiscellaneousController") or tr:find("AntiCheat") or tr:find("Security")) then
				return old({1, 2, 3}, {})
			end
		end
		return old(tbl, mt)
	end) or function(tbl, mt)
		return old(tbl, mt)
	end)
	AC.hooks.setmetatable = true
end)

-- 2) WalkSpeed / JumpPower spoof via __index / __newindex on Humanoid
local function installSpeedSpoof(hum)
	if not hum or not Toggles.ACBypass or not Toggles.ACBypass.Value then return end
	if not Toggles.SpeedBypass or not Toggles.SpeedBypass.Value then return end

	pcall(function()
		local mt = getrawmetatable and getrawmetatable(hum)
		if not mt then return end
		if type(setreadonly) == "function" then pcall(setreadonly, mt, false) end

		local oldIndex = mt.__index
		local oldNewIndex = mt.__newindex

		mt.__index = newcclosure and newcclosure(function(self, key)
			if key == "WalkSpeed" and Toggles.SpeedBypass and Toggles.SpeedBypass.Value then
				return 16 -- game reads 16
			end
			if key == "JumpPower" and Options.JumpBoost and Options.JumpBoost.Value > 0 then
				return 50
			end
			if type(oldIndex) == "function" then
				return oldIndex(self, key)
			end
			return rawget(self, key)
		end) or function(self, key)
			if key == "WalkSpeed" then return 16 end
			return type(oldIndex) == "function" and oldIndex(self, key) or rawget(self, key)
		end

		mt.__newindex = newcclosure and newcclosure(function(self, key, value)
			if key == "WalkSpeed" and Toggles.SpeedBypass and Toggles.SpeedBypass.Value then
				-- allow our sets, block game resets to 16 while we want speed
				if Toggles.WalkSpeedEnabled and Toggles.WalkSpeedEnabled.Value then
					State.RealSpeed = Options.WalkSpeed and Options.WalkSpeed.Value or 22
					return rawset(self, key, State.RealSpeed)
				end
			end
			if type(oldNewIndex) == "function" then
				return oldNewIndex(self, key, value)
			end
			return rawset(self, key, value)
		end) or function(self, key, value)
			return type(oldNewIndex) == "function" and oldNewIndex(self, key, value) or rawset(self, key, value)
		end

		AC.hooks.speedSpoof = true
	end)
end

-- 3) Remote namecall filter — suppress common speed/cheat report remotes
pcall(function()
	if type(hookmetamethod) ~= "function" and type(hookfunction) ~= "function" then return end

	local blocked = {
		"reportspeed", "speedcheck", "walkspeed", "anticheat", "kick", "ban",
		"detect", "flag", "security", "validate", "checkspeed",
	}

	local function shouldBlock(name)
		if not name then return false end
		local n = string.lower(tostring(name))
		for _, b in ipairs(blocked) do
			if string.find(n, b, 1, true) then return true end
		end
		return false
	end

	if type(hookmetamethod) == "function" then
		local old
		old = hookmetamethod(game, "__namecall", newcclosure and newcclosure(function(self, ...)
			local method = getnamecallmethod and getnamecallmethod() or ""
			if method == "FireServer" or method == "InvokeServer" then
				if Toggles.ACBypass and Toggles.ACBypass.Value and shouldBlock(self.Name) then
					return
				end
			end
			return old(self, ...)
		end) or function(self, ...)
			return old(self, ...)
		end)
		AC.hooks.namecall = true
	end
end)

