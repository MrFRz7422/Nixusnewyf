-- =========================================================
-- SPEED — no glitch method
-- When Speed Bypass is on: set real WalkSpeed once, spoof reads to 16
-- When off: soft re-apply only if the game resets it (no every-frame fight)
-- =========================================================
local lastAppliedSpeed = 0

local function applySpeed()
	local hum = getHum()
	if not hum then return end
	if not (Toggles.WalkSpeedEnabled and Toggles.WalkSpeedEnabled.Value) then return end

	local target = Options.WalkSpeed and Options.WalkSpeed.Value or 22
	State.RealSpeed = target

	if Toggles.SpeedBypass and Toggles.SpeedBypass.Value then
		-- set once; spoof handles server reads
		if math.abs(hum.WalkSpeed - target) > 0.5 then
			hum.WalkSpeed = target
			lastAppliedSpeed = target
		end
	else
		-- soft lock: only correct if game changed it
		if math.abs(hum.WalkSpeed - target) > 0.5 then
			hum.WalkSpeed = target
			lastAppliedSpeed = target
		end
	end
end

-- moderate re-apply (not every frame → no rubberband)
task.spawn(function()
	while true do
		task.wait(0.15)
		applySpeed()
		if Options.JumpBoost and Options.JumpBoost.Value > 0 then
			local hum = getHum()
			if hum then
				hum.UseJumpPower = true
				hum.JumpPower = 50 + Options.JumpBoost.Value
			end
		end
	end
end)

Options.WalkSpeed:OnChanged(function()
	applySpeed()
end)

Toggles.WalkSpeedEnabled:OnChanged(function()
